{
  "name": "Zlo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.5",
      "@types/node": "^26.6.3",
      "next": "^16.3.6",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "better-auth": "1.6.22",
      "effect": "^3.22.2",
      "vitest": "4.1.8",
      "@vitest/ui": "4.1.8",
      "@vitest/coverage-v8": "4.1.8",
      "jsdom": "^29.1.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @Zlo/db db:push",
    "db:studio": "turbo -F @Zlo/db db:studio",
    "db:generate": "turbo -F @Zlo/db db:generate",
    "db:migrate": "turbo -F @Zlo/db db:migrate",
    "test": "bun run --filter @Zlo/api test"
  },
  "dependencies": {
    "@Zlo/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Zlo/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "2.10.11",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "packageManager": "bun@1.3.14"
}