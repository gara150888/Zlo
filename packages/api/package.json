{
  "name": "@Zlo/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./server/*": {
      "default": "./src/server/*.ts"
    },
    "./server/services/*": {
      "default": "./src/server/services/*.ts"
    },
    "./server/services/automation/*": {
      "default": "./src/server/services/automation/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@Zlo/auth": "workspace:*",
    "@Zlo/db": "workspace:*",
    "@Zlo/env": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.3",
    "effect": "catalog:",
    "next": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Zlo/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
